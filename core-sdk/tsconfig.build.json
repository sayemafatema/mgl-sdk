{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": [
    "index.ts",
    "fleet-sdk.ts",
    "sdk-types.ts",
    "api/**/*.ts",
    "services/**/*.ts",
    "models/**/*.ts",
    "store/**/*.ts",
    "events/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
