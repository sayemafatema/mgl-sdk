<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/fleet_sdk_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fleet_sdk_title"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <TextView
        android:id="@+id/fleet_sdk_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/fleet_sdk_subtitle"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fleet_sdk_btn_complete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fleet_sdk_complete" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fleet_sdk_btn_cancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/fleet_sdk_cancel" />
</LinearLayout>
