# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node
node_modules/

# Build / web output (plugin + apps)
dist/

# Next.js
.next/
out/

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# JARs (allow Gradle Wrapper — required for ./gradlew)
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Maven / JVM
*.class
target/

pnpm-lock.yaml

# JetBrains IDE
.idea/

# Gradle — caches and outputs
.gradle/
**/build/

# Kotlin
.kotlin/

# Android / NDK
local.properties
.cxx/
externalNativeBuild/
captures/

# Swift Package Manager (local build products)
.build/

# Kotlin
.kotlin/

# Android / NDK (machine-local + generated)
local.properties
.cxx/
externalNativeBuild/
captures/

# Swift Package Manager — local build products (e.g. swift build / Xcode)
.build/

# VS Code — share workspace Git/SCM UX; other files stay local
.vscode/*
!.vscode/settings.json

# Reports / OS
TEST*.xml
.DS_Store
Thumbs.db

# Binaries
*.app
*.exe
*.war

# Large media
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Capacitor example — regenerate with `npm i` / `npx cap add …`
examples/capacitor-fleet-demo/node_modules/
examples/capacitor-fleet-demo/dist/
examples/capacitor-fleet-demo/android/
examples/capacitor-fleet-demo/ios/
