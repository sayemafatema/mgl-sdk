{
  "name": "@mgl/capacitor-fleet-sdk",
  "version": "0.5.0",
  "description": "Capacitor bridge for MGL Fleet native SDK (Kotlin/Swift cores)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "MglCapacitorFleetSdk.podspec",
    "android/",
    "ios/",
    "dist/",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=14.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_ORG/mgl-sdk.git",
    "directory": "plugins/capacitor-fleet"
  },
  "homepage": "https://github.com/YOUR_ORG/mgl-sdk/tree/main/plugins/capacitor-fleet",
  "bugs": {
    "url": "https://github.com/YOUR_ORG/mgl-sdk/issues"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "typescript": "~4.9.5"
  },
  "capacitor": {
    "android": {
      "src": "android"
    },
    "ios": {
      "src": "ios"
    }
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "fleet",
    "mgl"
  ],
  "license": "Apache-2.0"
}
